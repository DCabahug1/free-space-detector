# Public, safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://vituloqfqfrjdlblkuis.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_T-OApgS9A2f6lPjYH9jldw_Az0zv_NB

# Server only. Used by /api/ingest to write zone_counts. Never expose to the client.
# Copy from Supabase dashboard: Project Settings > API keys > service_role (or a secret key).
SUPABASE_SERVICE_ROLE_KEY=

# Campus map on the public map page. Google Cloud: enable Maps JavaScript API
# and Geocoding API, create a browser key restricted to the site's domains.
# Without the key the map block is not rendered. The map id is optional; the
# code falls back to Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
